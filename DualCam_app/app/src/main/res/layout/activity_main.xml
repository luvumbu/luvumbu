<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Aperçu de la caméra principale (orientation gérée automatiquement par CameraX) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:background="@color/overlay"
        android:textColor="@color/rec_red"
        android:textStyle="bold"
        android:textSize="14sp"
        android:visibility="invisible"
        android:text="● 00:00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="8dp"
        android:background="@color/overlay"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:text="📷 0 photo"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/recordButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/btn_record"
        android:contentDescription="@string/record"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/switchButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="48dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_switch"
        android:background="@color/overlay"
        android:contentDescription="@string/switch_cam"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bandeau « enregistrement en cours » : visible dès l'ouverture de l'app si ça filme
         (utile quand l'enregistrement a été lancé par la tuile, une secousse ou le volume). -->
    <LinearLayout
        android:id="@+id/livePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/overlay"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/liveDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_rec"
            android:textColor="@color/rec_red"
            android:textStyle="bold"
            android:textSize="14sp" />

        <Button
            android:id="@+id/livePreviewButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textSize="12sp"
            android:text="@string/live_preview_off" />

        <Button
            android:id="@+id/liveStopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:textSize="12sp"
            android:text="@string/live_stop" />
    </LinearLayout>

    <!-- Écran de choix de la caméra principale (au démarrage) — défilable -->
    <ScrollView
        android:id="@+id/chooser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/choose_main_camera"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/chooseBack"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/film_back" />

            <Button
                android:id="@+id/chooseFront"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/film_front" />

            <Button
                android:id="@+id/chooseScreen"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:text="@string/film_screen" />

            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/photo_hint"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />

            <View
                android:layout_width="240dp"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#333333" />

            <Button
                android:id="@+id/signInButton"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/sign_in_google"
                android:textColor="@color/white"
                android:background="#1565C0" />

            <TextView
                android:id="@+id/accountStatus"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/not_connected"
                android:textColor="#BBBBBB"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Boutons Réglages / Galerie : au-dessus de l'écran de départ (mais sous les panneaux) -->
    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        android:background="@color/overlay"
        android:contentDescription="@string/settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/galleryButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="12dp"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_gallery"
        android:background="@color/overlay"
        android:contentDescription="@string/gallery"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panneau réglages (ouvrable à tout moment via ⚙️) -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DD000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/settingsCard"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#222222">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/settings"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_every"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/intervalInput"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="@color/white"
                    android:autofillHints="" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seconds"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_shown"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
                <EditText
                    android:id="@+id/durationInput"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:inputType="number"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white"
                    android:autofillHints="" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/seconds"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/discreetCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/discreet_mode"
                android:textColor="@color/white"
                android:buttonTint="@color/white" />

            <CheckBox
                android:id="@+id/whiteCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/white_screen"
                android:textColor="@color/white"
                android:buttonTint="@color/white" />

            <CheckBox
                android:id="@+id/freezeCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/freeze_preview"
                android:textColor="@color/white"
                android:buttonTint="@color/white" />

            <CheckBox
                android:id="@+id/volumeCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/volume_control"
                android:textColor="@color/white"
                android:buttonTint="@color/white" />

            <CheckBox
                android:id="@+id/appAudioCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_audio"
                android:textColor="@color/white"
                android:buttonTint="@color/white" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/app_audio_hint"
                android:textColor="@color/white"
                android:alpha="0.7"
                android:textSize="12sp" />

            <Button
                android:id="@+id/cornerButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:text="@string/corner_prefix" />

            <Button
                android:id="@+id/camRotButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:text="@string/camrot_prefix" />

            <Button
                android:id="@+id/camModeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:text="@string/cammode_prefix" />

            <Button
                android:id="@+id/themeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:text="@string/theme_prefix" />

            <Button
                android:id="@+id/activationButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="12sp"
                android:background="#1565C0"
                android:textColor="@color/white"
                android:text="@string/activation_open" />

            <Button
                android:id="@+id/closeSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Écran de traitement (montage en cours) -->
    <LinearLayout
        android:id="@+id/processing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#DD000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/processingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/processing"
            android:textColor="@color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Panneau affiché quand l'enregistrement de l'écran est en cours -->
    <LinearLayout
        android:id="@+id/screenRecPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/screen_recording"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center" />

        <Button
            android:id="@+id/stopScreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stop" />
    </LinearLayout>

    <!-- Écran-cache du mode discret (recouvre tout ; appui long pour réafficher) -->
    <View
        android:id="@+id/discreetCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
