# Routage des URLs "propres" : /anniversaire/DUPONT -> index.html
# (le nom de l'espace est lu côté JavaScript dans l'URL)
RewriteEngine On
RewriteBase /anniversaire/

# Ne pas toucher aux vrais fichiers/dossiers (index.html, api.php, .htaccess...)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tout le reste est servi par l'app
RewriteRule ^ index.html [L]

# Empêche le navigateur de garder une vieille version en cache (HTML/PHP)
<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
