{
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "📚 Derniers articles",
      "size": "Large",
      "weight": "Bolder",
      "color": "Accent"
    },
    {
      "type": "Container",
      "items": [
        {
          "type": "TextBlock",
          "text": "${title}",
          "weight": "Bolder",
          "wrap": true
        },
        {
          "type": "TextBlock",
          "text": "${author}",
          "isSubtle": true,
          "spacing": "None"
        }
      ],
      "$data": "${articles}"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Ouvrir le blog",
      "url": "https://blog.mariondelval.com/mobile-app/"
    }
  ],
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json"
}
