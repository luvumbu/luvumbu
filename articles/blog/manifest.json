  "description": "Le blog complet : lis les articles, publie depuis ton téléphone, commente, partage.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#963637",
