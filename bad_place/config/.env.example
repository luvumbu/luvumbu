# ============================================================
#  Plateforme de signalement des discriminations
#  Copiez ce fichier vers config/.env et adaptez les valeurs
# ============================================================

# --- Application ---
APP_NAME="Plateforme Signalements"
APP_ENV=local              # local | production
APP_DEBUG=true             # true en dev, false en prod
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
# Préfixe si déployé dans un sous-dossier XAMPP (ex: /bad_place). Vide pour le serveur intégré.
APP_BASE_PATH=

# --- Base de données ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=badplace
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Sécurité / JWT ---
# Générez une clé forte : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=change_me_with_a_64_char_random_hex_string
JWT_ACCESS_TTL=900          # durée access token en secondes (15 min)
JWT_REFRESH_TTL=1209600     # durée refresh token en secondes (14 jours)
JWT_ISSUER=badplace

# Clé de chiffrement des données sensibles (AES-256). 64 caractères hex.
APP_ENCRYPTION_KEY=change_me_with_a_64_char_random_hex_string

# --- CORS (origines autorisées, séparées par des virgules) ---
# Inclure l'ID de l'extension Chrome une fois connu : chrome-extension://<id>
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost

# --- Rate limiting ---
RATE_LIMIT_MAX=120          # requêtes autorisées...
RATE_LIMIT_WINDOW=60        # ...par fenêtre en secondes

# --- Upload fichiers ---
UPLOAD_MAX_SIZE=20971520    # 20 Mo en octets
UPLOAD_ALLOWED_IMAGES=jpg,jpeg,png,webp,gif
UPLOAD_ALLOWED_VIDEOS=mp4,webm,mov
UPLOAD_ALLOWED_DOCS=pdf

# --- Email (SMTP) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=            # tls | ssl | (vide)
MAIL_FROM_ADDRESS=no-reply@badplace.local
MAIL_FROM_NAME="Plateforme Signalements"

# --- Géocodage (Nominatim / OpenStreetMap) ---
GEOCODING_ENDPOINT=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT="BadPlace/1.0 (contact@badplace.local)"

# --- OAuth (Phase 6 - laisser vide pour l'instant) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Publication immédiate des signalements. false = modération avant publication (recommandé en prod).
REPORTS_AUTO_PUBLISH=false

# Seuils de vigilance de zone (total de témoignages par ville)
ZONE_MEDIUM_AT=5
ZONE_HIGH_AT=15
