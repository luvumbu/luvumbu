# ============================================================
#  Routage : /api → API PHP (index.php) ; le reste → pages front
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 0. Transmet l'en-tête Authorization à PHP (Apache le filtre par défaut)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Les appels API partent vers le front controller PHP
    RewriteRule ^api(/|$) index.php [L]

    # 2. Les fichiers/dossiers réels (assets, images...) sont servis tels quels
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Tout le reste (routes front) est servi par la page principale
    RewriteRule ^ index.html [L]
</IfModule>

# Page d'accueil par défaut
DirectoryIndex index.html index.php

# Sécurité
<FilesMatch "\.(env|log|sql|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes
