<?xml version="1.0" encoding="utf-8"?>
<!-- Le fond (couleur) de ce cadre est défini dynamiquement selon l'origine :
     bleu = envoyé depuis le téléphone, orange = ajouté depuis le web. Le padding
     laisse apparaître ce cadre coloré tout autour de la vignette. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:padding="3dp">

    <ImageView
        android:id="@+id/photo"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="#16213a"
        android:contentDescription="@string/photo" />

    <!-- Pastille « lecture » affichée uniquement sur les vidéos. -->
    <ImageView
        android:id="@+id/playBadge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFFFFF"
        android:alpha="0.85"
        android:visibility="gone"
        android:contentDescription="@string/filter_videos" />

    <!-- Pastille d'origine (📱 téléphone / 🌐 web), en haut à gauche. -->
    <TextView
        android:id="@+id/sourceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="3dp"
        android:background="#99000000"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:textSize="11sp" />

    <!-- Date de l'élément, en bandeau lisible en bas de la vignette. -->
    <TextView
        android:id="@+id/dateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center" />
</FrameLayout>
